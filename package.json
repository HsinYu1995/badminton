{
  "name": "badminton",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/league-spartan": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/ui": "~57.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.6",
    "expo-auth-session": "~57.0.3",
    "expo-constants": "~57.0.5",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.5",
    "expo-router": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "supabase": "^2.109.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "android:emulator": "node ./scripts/start-android-emulator.js",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:schema": "node --env-file=.env.local tests/integration/schema.test.mjs",
    "test:rls": "node --env-file=.env.local tests/integration/rls.test.mjs",
    "test:auth-profile": "node --env-file=.env.local tests/integration/auth-profile-metadata.test.mjs",
    "test:create-event": "node --env-file=.env.local tests/integration/create-event.test.mjs",
    "test:skill-bands": "node --env-file=.env.local tests/integration/skill-bands.test.mjs",
    "test:auth-session": "node --env-file=.env.local tests/integration/auth-session.test.mjs",
    "test:profile-edit": "node --env-file=.env.local tests/integration/profile-edit.test.mjs",
    "test:participant-lifecycle": "node --env-file=.env.local tests/integration/participant-lifecycle.test.mjs",
    "test:participant-decision": "node --env-file=.env.local tests/integration/participant-decision.test.mjs",
    "test:ratings": "node --env-file=.env.local tests/integration/ratings.test.mjs",
    "test:discover-pagination": "node --env-file=.env.local tests/integration/discover-pagination.test.mjs",
    "test:guest-signup": "node --env-file=.env.local tests/integration/guest-signup.test.mjs",
    "test:guest-rls": "node --env-file=.env.local tests/integration/guest-rls.test.mjs",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testMatch": [
      "**/tests/unit/**/*.[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "[\\\\/]node_modules[\\\\/]",
      "tests[\\\\/]integration[\\\\/]"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ]
  }
}
